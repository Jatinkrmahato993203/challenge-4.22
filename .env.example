# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the HTTP/WebSocket server listens on.
PORT=3000

# API keys accepted by the server, formatted as comma-separated
# "key:role" pairs. A single key may hold multiple roles by joining
# them with "+". Valid roles are:
#   INGESTION_SOURCE     - devices posting signals (Gate_Counter/Ticket_Scanner/Transit_Feed)
#   VENUE_OPS_MANAGER    - venue operations manager
#   GATE_STAFF           - gate staff
#   TRANSIT_DISPATCHER   - transit dispatcher
#   AUDITOR              - read-only audit access
#
# Example (these are fake, non-secret placeholder keys - generate your
# own random, high-entropy keys for real environments):
API_KEYS="dev-ingestion-key-0001:INGESTION_SOURCE,dev-ops-key-0002:VENUE_OPS_MANAGER,dev-multi-key-0003:GATE_STAFF+AUDITOR"

# Comma-separated list of browser origins allowed to make cross-origin
# requests to this API. If unset, no origin is allowed (the
# Access-Control-Allow-Origin header is omitted for every request).
ALLOWED_ORIGINS="http://localhost:5173,https://ops-dashboard.example.com"
